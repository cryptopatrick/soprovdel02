# /etc/nginx/sites-available/soprovdel02 – SO-prov del 2: provsidan och rättningen via Node på 127.0.0.1:8793.
# certbot --nginx -d soprov2.49-12-204-84.sslip.io lägger till HTTPS-delen.
server {
    listen 80;
    listen [::]:80;
    server_name soprov2.49-12-204-84.sslip.io;

    client_max_body_size 200k;

    location = /ratta {
        limit_req zone=soprovdel02_ratta burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8793;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(|index\.html|fragor\.js|status)$ {
        proxy_pass http://127.0.0.1:8793;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        return 404;
    }

    gzip on;
    gzip_types text/css application/javascript text/javascript application/json;
}
